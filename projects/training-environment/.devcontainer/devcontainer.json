{
  // human readable name shown in vs code when the container is running
  "name": "healthcare-ai-training-environment",

  // base image that already has python set up, maintained by the official
  // devcontainers project, so there's no need to reinvent a python install
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // "features" are pluggable add-ons for dev containers. this one bolts a java
  // runtime onto the python base image, needed because synthea (the
  // fake-patient generator going in next) is a java program
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },

  // runs once after the container is built, installs the python libraries
  // listed in requirements.txt so they're ready the moment the container opens
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",

  // editor setup applied automatically inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
